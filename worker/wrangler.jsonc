{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cara-demo-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-09-09",
	"routes": [
		{
			"pattern": "worker.cara-demo-jhu.uk",
			"custom_domain": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "cara-demo-flags",
			"binding": "cara_demo_flags",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "cara_demo_flags_d1",
			"database_name": "cara-demo-flags-d1",
			"database_id": "e3ae6210-6772-449c-b187-a958c897cfcc",
			"remote": true
		}
	]
}